{
  "data_asset_type": "Dataset",
  "expectation_suite_name": "orders_quality_suite",
  "expectations": [
    {
      "expectation_type": "expect_table_row_count_to_be_between",
      "kwargs": {
        "min_value": 0,
        "max_value": null
      },
      "meta": {
        "notes": "Verificar que existan órdenes en la tabla"
      }
    },
    {
      "expectation_type": "expect_table_columns_to_match_ordered_list",
      "kwargs": {
        "column_list": [
          "order_id",
          "customer_id",
          "order_date",
          "total_amount",
          "status",
          "created_at",
          "updated_at"
        ]
      },
      "meta": {
        "notes": "Validar estructura de columnas de la tabla orders"
      }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {
        "column": "order_id"
      },
      "meta": {
        "notes": "order_id es clave primaria y no debe ser null"
      }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {
        "column": "customer_id"
      },
      "meta": {
        "notes": "customer_id es requerido"
      }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {
        "column": "order_date"
      },
      "meta": {
        "notes": "order_date es requerido"
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_of_type",
      "kwargs": {
        "column": "total_amount",
        "type_": "DECIMAL"
      },
      "meta": {
        "notes": "total_amount debe ser DECIMAL"
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_between",
      "kwargs": {
        "column": "total_amount",
        "min_value": 0,
        "max_value": 1000000,
        "mostly": 0.95
      },
      "meta": {
        "notes": "95% de las órdenes deben tener un monto entre 0 y 1,000,000"
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_in_set",
      "kwargs": {
        "column": "status",
        "value_set": [
          "pending",
          "processing",
          "completed",
          "cancelled",
          "shipped"
        ]
      },
      "meta": {
        "notes": "status debe ser uno de los valores permitidos"
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_unique",
      "kwargs": {
        "column": "order_id"
      },
      "meta": {
        "notes": "order_id debe ser único (clave primaria)"
      }
    },
    {
      "expectation_type": "expect_column_values_to_match_strftime_format",
      "kwargs": {
        "column": "order_date",
        "strftime_format": "%Y-%m-%d %H:%M:%S"
      },
      "meta": {
        "notes": "order_date debe tener formato de timestamp válido"
      }
    },
    {
      "expectation_type": "expect_column_proportion_of_unique_values_to_be_between",
      "kwargs": {
        "column": "customer_id",
        "min_value": 0.1,
        "max_value": 1.0
      },
      "meta": {
        "notes": "Debe haber variedad de clientes (al menos 10% de valores únicos)"
      }
    },
    {
      "expectation_type": "expect_compound_columns_to_be_unique",
      "kwargs": {
        "column_list": ["customer_id", "order_date"]
      },
      "meta": {
        "notes": "Un cliente no debería tener múltiples órdenes en el mismo segundo"
      }
    }
  ],
  "meta": {
    "great_expectations_version": "0.18.0",
    "notes": "Suite de validación para la tabla orders. Valida tipos de datos, valores permitidos y reglas de negocio."
  }
}
